011e  66 bc 04 00 00 00        MOV ESP,0x4
0124  66 89 c2                 MOV EDX,EAX ; previous factorial
0127  66 89 f1                 MOV ECX,ESI ; multiply by n using n additions
012a  66 b8 00 00 00 00        MOV EAX,0x0
0130  66 01 d0                 ADD EAX,EDX
0133  66 29 d9                 SUB ECX,EBX
