# Real-mode subset: restore writable 386 bits, preserve RF/VM and reserved state.
require_width 16_or_32
require_real_mode
read_gpr old_sp 4 $S
zext offset old_sp 32
load_segment packed 2 offset $W
const step $S $BYTES
add new_sp old_sp step
write_gpr 4 new_sp
bit f0 packed 0
flag CF f0
bit f2 packed 2
flag PF f2
bit f4 packed 4
flag AF f4
bit f6 packed 6
flag ZF f6
bit f7 packed 7
flag SF f7
bit f8 packed 8
flag TF f8
bit f9 packed 9
flag IF f9
bit f10 packed 10
flag DF f10
bit f11 packed 11
flag OF f11
bit f12 packed 12
flag IOPL0 f12
bit f13 packed 13
flag IOPL1 f13
bit f14 packed 14
flag NT f14
retire
