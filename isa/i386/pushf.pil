# Documented 386 FLAGS bits only; reserved bit1 set, RF/VM absent from image.
# Any privilege level may push the flags; virtual-8086 mode needs IOPL 3,
# else #GP(0).
require_width 16_or_32
read_flags raw
bit vm raw 17
not no_vm vm
bit v86_iopl0 raw 12
bit v86_iopl1 raw 13
and v86_iopl3 v86_iopl0 v86_iopl1
or iopl_allowed no_vm v86_iopl3
raise_unless iopl_allowed 13
const visible 32 32725
and defined raw visible
const fixed 32 2
or packed defined fixed
trunc data packed $W
read_gpr old_sp 4 $S
const step $S $BYTES
sub new_sp old_sp step
zext offset new_sp 32
store_segment 2 offset data
write_gpr 4 new_sp
preserve_flags all
retire
