# SHRD: shift dst right, filling from the bottom of src. The 386 masks the count
# to five bits; a zero count changes no flags. A 16-bit count above 16 leaves
# the result undefined, so this profile rejects it instead of guessing.
$OPERAND
read b src $W
$COUNT
const count_mask 8 31
and masked raw count_mask
zext count masked $W
const width $W $W
ult over width count
not fits over
require fits
const one $W 1
const yes 1 1
const no 1 0
zero is_zero count
not active is_zero
xor count_minus_one count one
zero single count_minus_one
zext a_wide a $DOUBLE
zext b_wide b $DOUBLE
const half $DOUBLE $W
shl b_high b_wide half
or joined b_high a_wide
zext count_wide count $DOUBLE
lshr moved joined count_wide
trunc r moved $W
sub back count one
lshr out a back
bit cf out 0
bit sf r $SIGN
bit old_sign a $SIGN
xor of sf old_sign
zero zf r
parity pf r
$WRITE
flag_if CF cf yes active
flag_if OF of single active
flag_if AF no no active
flag_if SF sf yes active
flag_if ZF zf yes active
flag_if PF pf yes active
retire
