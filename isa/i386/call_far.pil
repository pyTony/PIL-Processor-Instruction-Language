# Far CALL. far_call checks the target first (privilege.rs): through a call
# gate it performs the whole transfer, at the gate's size and, for a more
# privileged nonconforming segment, on the stack from the TSS, and nothing
# below runs. A code segment comes back for the pushes here, at the operand
# size on the current stack; both are checked before either is staged.
require_width 16_or_32
$FAR_TARGET
zext target32 target_value 32
far_call selector target32
read_segment old_cs 1
zext return_cs old_cs $W
read_ip next next 32
trunc return_offset next $W
read_gpr old_sp 4 $S
const slot_bytes $S $BYTES
sub selector_sp old_sp slot_bytes
sub new_sp selector_sp slot_bytes
zext stack_wide new_sp 64
check_segment 2 stack_wide $FRAME
zext selector_offset selector_sp 32
zext stack_offset new_sp 32
store_segment 2 selector_offset return_cs
store_segment 2 stack_offset return_offset
write_gpr 4 new_sp
preserve_flags all
retire
