read_flag backward DF
const step $A $BYTES
const zero $A 0
sub backwards zero step
select stride backward backwards step
read_gpr si 6 $A
read_gpr di 7 $A
zext source si 32
zext destination di 32
load_segment element $SEG source $W
store_segment 0 destination element
add new_si si stride
add new_di di stride
write_gpr 6 new_si
write_gpr 7 new_di
preserve_flags all
retire
