# PUSHA/PUSHAD: push AX/EAX, CX, DX, BX, the original SP, BP, SI, DI.
# Every register is read first; the eight stores are staged and commit together.
require_width 16_or_32
read_gpr old_sp 4 $S
read_gpr r0 0 $W
read_gpr r1 1 $W
read_gpr r2 2 $W
read_gpr r3 3 $W
read_gpr r4 4 $W
read_gpr r5 5 $W
read_gpr r6 6 $W
read_gpr r7 7 $W
const step $S $BYTES
sub a0 old_sp step
zext o0 a0 32
store o0 r0
sub a1 a0 step
zext o1 a1 32
store o1 r1
sub a2 a1 step
zext o2 a2 32
store o2 r2
sub a3 a2 step
zext o3 a3 32
store o3 r3
sub a4 a3 step
zext o4 a4 32
store o4 r4
sub a5 a4 step
zext o5 a5 32
store o5 r5
sub a6 a5 step
zext o6 a6 32
store o6 r6
sub a7 a6 step
zext o7 a7 32
store o7 r7
write_gpr 4 a7
preserve_flags all
retire
