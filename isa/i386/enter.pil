# ENTER size,level: push BP/EBP, copy level-1 frame display pointers when
# level > 0, push the new frame pointer, set BP/EBP to the frame pointer,
# and subtract the unsigned 16-bit allocation size from SP/ESP.
require_width 16_or_32
read_gpr old_sp 4 $S
read_gpr old_bp 5 $W
const step $S $BYTES
sub sp0 old_sp step
zext at0 sp0 32
store_segment 2 at0 old_bp
$FRAME_PTR
$NESTING
const size $S $SIZE
sub new_sp $SP_AFTER size
write_gpr 5 frame_ptr
write_gpr 4 new_sp
preserve_flags all
retire
