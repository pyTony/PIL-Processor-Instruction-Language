# Rotate CF:dst right as a $EXT-bit ring. The 386 masks the count to five
# bits, then reduces it modulo $EXT; flags change only for a non-zero masked
# count, with OF set to the two top bits of the result XORed.
read a dst $W
read b src $W
read_flag carry CF
const count_mask $W 31
and count b count_mask
zext count_ext count $EXT
const ring $EXT $EXT
rem turns count_ext ring
sub complement ring turns
zext a_ext a $EXT
zext c_ext carry $EXT
const top $EXT $W
shl c_high c_ext top
or v a_ext c_high
lshr right v turns
shl left v complement
or rotated left right
trunc r rotated $W
bit cf rotated $W
bit msb r $SIGN
const one $W 1
shl doubled r one
bit second doubled $SIGN
xor of msb second
const yes 1 1
zero is_zero count
not active is_zero
write dst r
flag_if CF cf yes active
flag_if OF of yes active
preserve_flags remaining
retire
