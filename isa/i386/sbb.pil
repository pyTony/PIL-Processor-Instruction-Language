# SBB: widened a-b-CF; preserve the original b for OF and AF.
read a dst $W
read b src $W
zext aw a $EXT
zext bw b $EXT
read_flag borrow CF
zext cw borrow $EXT
sub partial aw bw
sub wide partial cw
trunc r wide $W
bit cf wide $W
xor ab a b
xor ar a r
and overflow ab ar
bit of overflow $SIGN
xor abr ab r
bit af abr 4
bit sf r $SIGN
zero zf r
parity pf r
write dst r
flag CF cf
flag PF pf
flag AF af
flag ZF zf
flag SF sf
flag OF of
retire
