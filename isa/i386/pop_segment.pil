# Read through old SS and update SP using the old stack-address width. Only the
# selector word is read, also for a 32-bit pop (the 386 reads no upper half, so
# SP=FFFEh does not fault).
require_width 16_or_32
read_gpr old_sp 4 $S
zext offset old_sp 32
load selector offset 16
write_segment $SEG selector
const step $S $BYTES
add new_sp old_sp step
write_gpr 4 new_sp
preserve_flags all
retire
