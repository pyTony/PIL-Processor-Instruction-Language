# Descriptor-table loads (real mode or CPL 0); commit only after the whole operand is read.
require_width 16_or_32
require_ring0
read_address pointer
zext span pointer 64
check_segment $SEG span 6
load limit pointer 16
const two 32 2
add base_at pointer two
load raw_base base_at 32
const mask 32 $MASK
and base raw_base mask
write_table $TABLE limit base
preserve_flags all
retire
