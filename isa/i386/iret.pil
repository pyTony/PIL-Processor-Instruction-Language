# Real-mode interrupt return: read IP, CS and FLAGS before staging, then branch
# and restore the writable 386 flags as POPF does. Each slot offset wraps at the
# stack-address width, so a 16-bit frame at SP=FFFCh reads FFFC, FFFE and 0000;
# a single slot that crosses the segment limit still faults. The CS slot is a
# full operand-size slot (a 32-bit one at SP=FFFDh crosses the limit and faults).
require_width 16_or_32
require_real_mode
read_gpr old_sp 4 $S
zext stack_offset old_sp 32
load_segment target_value 2 stack_offset $W
const slot $S $BYTES
add selector_sp old_sp slot
zext selector_offset selector_sp 32
load_segment selector_value 2 selector_offset $W
trunc selector selector_value 16
add flags_sp selector_sp slot
zext flags_offset flags_sp 32
load_segment packed 2 flags_offset $W
zext target32 target_value 32
far_branch selector target32
const frame_bytes $S $FRAME
add new_sp old_sp frame_bytes
write_gpr 4 new_sp
bit f0 packed 0
flag CF f0
bit f2 packed 2
flag PF f2
bit f4 packed 4
flag AF f4
bit f6 packed 6
flag ZF f6
bit f7 packed 7
flag SF f7
bit f8 packed 8
flag TF f8
bit f9 packed 9
flag IF f9
bit f10 packed 10
flag DF f10
bit f11 packed 11
flag OF f11
bit f12 packed 12
flag IOPL0 f12
bit f13 packed 13
flag IOPL1 f13
bit f14 packed 14
flag NT f14
retire
