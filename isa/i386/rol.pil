# Mask the 386 count, rotate data modulo width, classify flags by masked count.
read a dst $W
read b src $W
const count_mask $W 31
and count b count_mask
const turn_mask $W $SIGN
and turns count turn_mask
const width $W $W
sub complement width turns
const yes 1 1
zero is_zero count
not active is_zero
shl left a turns
lshr right a complement
or r left right
bit cf r 0
bit top r $SIGN
xor of top cf
write dst r
flag_if CF cf yes active
flag_if OF of yes active
preserve_flags remaining
retire
