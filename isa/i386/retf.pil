# Far return: read IP and CS, then far_return (privilege.rs) checks the
# return CS and, for a return to an outer level, pops ESP and SS from above
# the frame and the imm16 cleanup, adds the cleanup to the new ESP too, and
# nulls data segments the outer level may not use. Each slot offset wraps
# at the stack-address width (SP=FFFEh reads FFFE then 0000); the CS slot
# is a full operand-size slot, unlike POP Sreg, which reads only a word.
require_width 16_or_32
read_gpr old_sp 4 $S
zext stack_offset old_sp 32
load_segment target_value 2 stack_offset $W
const slot $S $BYTES
add selector_sp old_sp slot
zext selector_offset selector_sp 32
load_segment selector_value 2 selector_offset $W
trunc selector selector_value 16
zext target32 target_value 32
const frame_bytes $S $FRAME
const cleanup $S $CLEANUP
add popped old_sp frame_bytes
add outer_sp popped cleanup
zext outer outer_sp 32
far_return selector target32 outer $BYTES $CLEANUP
preserve_flags all
retire
