# Far return, real mode or CPL 0: read IP and CS before staging CS/IP/SP. Each slot offset
# wraps at the stack-address width (SP=FFFEh reads FFFE then 0000); the CS slot
# is a full operand-size slot, unlike POP Sreg, which reads only a word.
require_width 16_or_32
require_ring0
read_gpr old_sp 4 $S
zext stack_offset old_sp 32
load_segment target_value 2 stack_offset $W
const slot $S $BYTES
add selector_sp old_sp slot
zext selector_offset selector_sp 32
load_segment selector_value 2 selector_offset $W
trunc selector selector_value 16
zext target32 target_value 32
far_branch selector target32
const frame_bytes $S $FRAME
const cleanup $S $CLEANUP
add popped old_sp frame_bytes
add new_sp popped cleanup
write_gpr 4 new_sp
preserve_flags all
retire
