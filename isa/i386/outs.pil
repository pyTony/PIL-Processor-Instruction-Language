# OUTS (6E/6F): read an element from $SEG:[SI/ESI] (default DS) to the port
# in DX and advance SI/ESI by DF.
read_gpr port 2 16
check_io port $BYTES
read_flag backward DF
const step $A $BYTES
const zero $A 0
sub backwards zero step
select stride backward backwards step
read_gpr si 6 $A
zext source si 32
load_segment element $SEG source $W
add new_si si stride
write_gpr 6 new_si
preserve_flags all
retire
