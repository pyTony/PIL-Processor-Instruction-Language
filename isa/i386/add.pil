# ADD: the interpreter contains no hardcoded x86 arithmetic flag update.
# $W, $EXT and $SIGN are build-time template parameters.
read a dst $W
read b src $W
zext aw a $EXT
zext bw b $EXT
add wide aw bw
trunc r wide $W
bit cf wide $W
xor ab a b
not nab ab
xor ar a r
and overflow nab ar
bit of overflow $SIGN
xor abr ab r
bit af abr 4
bit sf r $SIGN
zero zf r
parity pf r
write dst r
flag CF cf
flag PF pf
flag AF af
flag ZF zf
flag SF sf
flag OF of
retire
