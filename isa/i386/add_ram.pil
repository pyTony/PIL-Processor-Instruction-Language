# Read-modify-write ADD semantics over flat RAM, with explicit flags.
read_address addr
load a addr $W
read b src $W
zext aw a $EXT
zext bw b $EXT
add wide aw bw
trunc r wide $W
bit cf wide $W
xor ab a b
not nab ab
xor ar a r
and overflow nab ar
bit of overflow $SIGN
xor abr ab r
bit af abr 4
bit sf r $SIGN
zero zf r
parity pf r
store addr r
flag CF cf
flag PF pf
flag AF af
flag ZF zf
flag SF sf
flag OF of
retire
