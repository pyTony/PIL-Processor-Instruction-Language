# Bounded real-mode LES/LDS/LSS/LFS/LGS. Read the whole pointer before staging
# either write. $DEST is the segment register index: 0 for ES (LES), 3 for DS
# (LDS), 2, 4 or 5 for LSS, LFS and LGS. Each field is checked on its own, and
# the selector offset wraps at the address size, as the 386 does: a 16-bit EA
# of FFFEh reads the offset word there and the selector at 0000h.
require_width 16_or_32
require_real_mode
read_address pointer
const size 32 $BYTES
add selector_end pointer size
const offset_mask 32 $OFFSET_MASK
and selector_at selector_end offset_mask
zext wide_offset pointer 64
check_segment $SEG wide_offset $BYTES
zext wide_selector selector_at 64
check_segment $SEG wide_selector 2
load offset pointer $W
load selector selector_at 16
write dst offset
write_segment $DEST selector
preserve_flags all
retire
