# Load low CR0 status bits from a word; other status bits and flags stay put.
# PE cannot be cleared by LMSW. Mode transitions are validated by the machine.
require_width 16
read input src 16
read_msw current
const low_mask 16 15
const high_mask 16 65520
const pe_mask 16 1
and new_low input low_mask
and old_high current high_mask
and old_pe current pe_mask
or low_with_pe new_low old_pe
or merged old_high low_with_pe
zext value merged 32
write_control 0 value
preserve_flags all
retire
