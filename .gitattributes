* text=auto eol=lf
# GW-BASIC ASCII programs require DOS CRLF in every checkout.
programs/dos/*.BAS -text
# Generated by pil --emit-precompiled-forms; CI checks it is current.
src/precompiled/forms.rs linguist-generated=true
# Every PR adds its own note at the top of CLAUDE.md, so two PRs always touch
# the same lines. Union merge keeps both notes instead of a conflict (git
# merge on any machine and the update-prs workflow; not GitHub's web merge).
# docs/development/STATUS.md gets the same note at its top, so the same rule.
CLAUDE.md merge=union
docs/development/STATUS.md merge=union
